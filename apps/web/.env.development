# Solo para npm run dev: dónde está la API en local. No es un secreto.
# En producción, VITE_API_URL se configura en Vercel (GO-02). Si no está, la web
# no pregunta a la API y usa la foto del contenido que lleva dentro.
VITE_API_URL=http://localhost:3001

# La dirección del panel (VITE_ADMIN_PATH) NO va aquí: este archivo se sube al repo. Va en
# apps/web/.env.local (que git ignora), con este formato y tu propio valor aleatorio:
#   VITE_ADMIN_PATH=/p-xxxxxxxxxx
# Sin ella, el panel no existe en la web.

# Medir las visitas (ADM-10): Umami, en nuestro servidor (INFRA). Vacío en local: la web no
# carga nada. En producción van en Vercel (GO-02); no son secretos (acaban en el HTML):
#   VITE_UMAMI_URL=https://visitas.mateorodriguez.solutions
#   VITE_UMAMI_WEBSITE_ID=el-id-del-sitio-en-tu-umami
# Solo cuenta en tu dominio. Para probarlo en local con un Umami en Docker, además:
#   VITE_UMAMI_DOMINIOS=localhost
