# Copia este archivo a .env y rellena cada valor. El .env nunca se sube al repo.
# Las tres son obligatorias: si falta alguna, la API no arranca.

# Clave para firmar cookies y tokens. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conexión a PostgreSQL. El +psycopg2 es obligatorio: sin él, SQLAlchemy 2.1
# busca el driver psycopg 3, que no está instalado. Formato:
#   postgresql+psycopg2://usuario:contraseña@localhost:5432/portfolio
DATABASE_URL=

# Orígenes que pueden llamar a la API, separados por comas. En local:
#   http://localhost:3000
CORS_ORIGINS=

# --- Opcionales: gráfico de contribuciones (GET /api/contributions) ---
# Sin ellas la API arranca, pero no consulta GitHub. Token "fine-grained" de solo
# lectura de repositorios públicos, sin ningún permiso más:
#   GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
GITHUB_TOKEN=
GITHUB_LOGIN=mateore1330-commits

# --- Opcionales: aviso por correo del formulario de contacto ---
# Sin ellas, los mensajes se guardan igual y `pipenv run reenviar-avisos` los envía
# cuando estén. Con Hostinger: smtp.hostinger.com, puerto 465 (SSL), tu correo y la
# contraseña de ese buzón. CONTACT_TO: adónde llegan los avisos (si vacío, a SMTP_USER).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=

# --- Solo para la semilla (pipenv run seed). La API no las necesita para arrancar. ---
# Crean el usuario administrador si todavía no existe. Si ya existe, no se tocan.
# Contraseña de 12 caracteres o más. Después de crearlo, se pueden borrar de aquí.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Solo para el CV (pipenv run generar-cv). ---
# Tu teléfono, para la versión del CV que envías tú (va a apps/api/cv-privado/, que git
# ignora). El CV que se descarga desde la web nunca lo lleva. Vacío: solo las públicas.
CV_TELEFONO=

# --- Opcional: la cookie de la sesión del panel (ADM-01) ---
# Por defecto solo viaja por HTTPS (Secure). Chrome la acepta también en http://localhost;
# si en local usas otro navegador que no la guarda, pon COOKIE_SECURE=0 (nunca en producción).

# --- Solo en el servidor: los proxies que hay delante (INFRA-03) ---
# Con Caddy delante, 1: así la API toma la IP del visitante (la que usan los límites del
# formulario y de entrar al panel) y no la de Caddy. En local, vacío.
PROXIES=
COOKIE_SECURE=1

# --- Opcional: publicar desde el panel (ADM-05) ---
# El gancho de despliegue de Vercel: Vercel → el proyecto → Settings → Git → Deploy Hooks.
# Sin él, publicar funciona igual (la web lee la foto nueva de la API) y el paso de
# Vercel dice "Sin configurar".
VERCEL_DEPLOY_HOOK=

# --- Opcional: las fotos de los proyectos y los certificados (ADM-08) ---
# Cloudinary → tu cuenta → panel → "API environment variable" (empieza por cloudinary://).
# Sin ella, el panel no puede subir archivos (lo avisa). Es secreta: solo aquí.
# Con una clave propia (Settings → API Keys, rol Master Admin) mejor que la Root.
# Y en Settings → Security, activar "Allow delivery of PDF and ZIP files": las cuentas
# nuevas no sirven PDF y los certificados darían 401.
CLOUDINARY_URL=

# --- Opcional: las visitas en el panel (ADM-10) ---
# Umami instalado en nuestro servidor (INFRA-03). La API entra con tu usuario de Umami y le
# pide las cifras; el navegador nunca las ve. Sin ellas, Visitas dice que no está configurado.
# UMAMI_URL: la dirección de Umami vista desde la API (en el servidor, la interna de Docker,
#   p. ej. http://umami:3000). UMAMI_WEBSITE_ID: Umami → Websites → Edit → Website ID.
# La contraseña es secreta: solo aquí.
UMAMI_URL=
UMAMI_USUARIO=
UMAMI_CONTRASENA=
UMAMI_WEBSITE_ID=
