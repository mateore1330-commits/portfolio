# Copia este archivo a .env y rellena cada valor. El .env nunca se sube al repo.
# Las tres son obligatorias: si falta alguna, la API no arranca.

# Clave para firmar cookies y tokens. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Conexión a PostgreSQL. El +psycopg2 es obligatorio: sin él, SQLAlchemy 2.1
# busca el driver psycopg 3, que no está instalado. Formato:
#   postgresql+psycopg2://usuario:contraseña@localhost:5432/portfolio
DATABASE_URL=

# Orígenes que pueden llamar a la API, separados por comas. En local:
#   http://localhost:3000
CORS_ORIGINS=

# --- Opcionales: gráfico de contribuciones (GET /api/contributions) ---
# Sin ellas la API arranca, pero no consulta GitHub. Token "fine-grained" de solo
# lectura de repositorios públicos, sin ningún permiso más:
#   GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
GITHUB_TOKEN=
GITHUB_LOGIN=mateore1330-commits

# --- Opcionales: aviso por correo del formulario de contacto ---
# Sin ellas, los mensajes se guardan igual y `pipenv run reenviar-avisos` los envía
# cuando estén. Con Hostinger: smtp.hostinger.com, puerto 465 (SSL), tu correo y la
# contraseña de ese buzón. CONTACT_TO: adónde llegan los avisos (si vacío, a SMTP_USER).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=

# --- Solo para la semilla (pipenv run seed). La API no las necesita para arrancar. ---
# Crean el usuario administrador si todavía no existe. Si ya existe, no se tocan.
# Contraseña de 12 caracteres o más. Después de crearlo, se pueden borrar de aquí.
ADMIN_EMAIL=
ADMIN_PASSWORD=
