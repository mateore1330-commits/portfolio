# La configuración de la API en el servidor (INFRA-03). Plantilla SIN valores.
# En el servidor lo crea infra/servidor/infra-03.sh (permisos 600). Lo opcional (correo,
# Cloudinary, GitHub, Vercel, Umami) se rellena después (GO-03). Ver apps/api/.env.example.

SECRET_KEY=
# postgresql+psycopg2://portfolio:<PORTFOLIO_DB_PASSWORD del .env>@db:5432/portfolio
DATABASE_URL=
CORS_ORIGINS=https://mateorodriguez.solutions,https://www.mateorodriguez.solutions
# Caddy va delante: la API toma la IP del visitante (límites del formulario y del panel).
PROXIES=1
COOKIE_SECURE=1

# Opcionales (GO-03)
GITHUB_TOKEN=
GITHUB_LOGIN=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO=
CLOUDINARY_URL=
VERCEL_DEPLOY_HOOK=
CV_TELEFONO=
UMAMI_URL=http://umami:3000
UMAMI_USUARIO=
UMAMI_CONTRASENA=
UMAMI_WEBSITE_ID=
