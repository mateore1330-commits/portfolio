# Caddy (INFRA-04): HTTPS con Let's Encrypt, que pide y renueva los certificados solo.
#
#   api.      → la API entera (/api/…). Lo demás, 404.
#   visitas.  → solo el contador de Umami (/script.js y /api/send). Su panel NO se ve desde fuera.
#   :8081     → el panel de Umami, solo dentro del servidor (compose lo publica en 127.0.0.1):
#               se entra con un túnel SSH (ver portfolio-privado/servidor.md).
#
# Los dominios vienen de docker-compose.yml (para probarlo en local con *.localhost). La IP a
# secas no tiene sitio: no responde nada.
{
	servers {
		# Sin HTTP/3: va por UDP y los cortafuegos solo dejan pasar TCP.
		protocols h1 h2
	}
}

(seguridad) {
	header {
		# Solo por HTTPS durante un año. Sin includeSubDomains: no obliga a otros subdominios.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Que no digan qué programa hay detrás (defer: después de que el proxy añada las suyas).
		-Server
		-Via
		defer
	}
}

{$DOMINIO_API} {
	import seguridad
	handle /api/* {
		reverse_proxy api:8000
	}
	respond 404
}

{$DOMINIO_VISITAS} {
	import seguridad
	@contador path /script.js /api/send
	handle @contador {
		reverse_proxy umami:3000
	}
	respond 404
}

http://:8081 {
	reverse_proxy umami:3000
}
