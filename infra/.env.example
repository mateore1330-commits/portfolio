# El .env del servidor para docker-compose.yml (INFRA-03). Plantilla SIN valores.
# En el servidor lo crea infra/servidor/2-docker.sh con valores aleatorios (permisos 600).
# Solo letras y números (van dentro de direcciones de conexión).

# El usuario "jefe" de PostgreSQL: solo para crear las bases la primera vez.
POSTGRES_PASSWORD=
# El usuario de la API (base "portfolio"). La misma va en DATABASE_URL de api.env.
PORTFOLIO_DB_PASSWORD=
# El usuario de Umami (base "umami").
UMAMI_DB_PASSWORD=
# La clave interna de Umami (sus sesiones).
UMAMI_APP_SECRET=
